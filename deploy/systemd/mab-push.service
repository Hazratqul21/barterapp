[Unit]
Description=MAB: yuborilmagan push bildirishnomalar
After=postgresql.service

[Service]
Type=oneshot
User=mab
WorkingDirectory=/opt/mab/api
# .env ni ilovaning o'zi o'qiydi (WorkingDirectory'dan). systemd yoki
# bash orqali o'qitilsa CORS_ORIGINS dagi JSON qo'shtirnoqlari yo'qoladi.
ExecStart=/opt/mab/api/.venv/bin/python -m app.push_send
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
# Kod va .venv faqat o'qish uchun: API buzilsa ham o'z kodini qayta yozib
# o'zini mustahkamlay olmasin. Yozish faqat yuklangan fayllarga.
ProtectSystem=strict
ReadWritePaths=/opt/mab/media
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0027
# Kod papkasi faqat o'qish uchun — Python .pyc yozishga urinmasin.
Environment=PYTHONDONTWRITEBYTECODE=1
