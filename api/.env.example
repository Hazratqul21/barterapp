# MAB — server sozlamalari
#
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring. `.env` git'ga
# tushmaydi (`.gitignore` da). Sozlamalarning to'liq ro'yxati va standart
# qiymatlari: `app/core/config.py`.

# ─────────────────────────────────────────────────────────────────────────────
# Muhit
# ─────────────────────────────────────────────────────────────────────────────
# development | test | production. production'da server xavfli sozlama bilan
# ishga tushmaydi: OTP_DEBUG=true, zaif JWT_SECRET, SMS sozlanmagan yoki
# SMS_REQUIRED=false, CORS_ORIGINS da *, http yoki localhost.
APP_ENV=development

# Veb-ilova domenlari, JSON ro'yxat. Productionda faqat https va aniq domen.
# CORS_ORIGINS=["https://mab.uz","https://www.mab.uz"]

# ─────────────────────────────────────────────────────────────────────────────
# Baza
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://barter:barter@localhost:5434/barter

# ─────────────────────────────────────────────────────────────────────────────
# Xavfsizlik — ishlab chiqarishda MAJBURIY
# ─────────────────────────────────────────────────────────────────────────────
# Standart qiymat "dev-only-change-me". U bilan ishga tushirilgan server
# istalgan odam yasagan token'ni qabul qiladi — ya'ni har kimning hisobiga
# kirish mumkin. Yangi kalit:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
JWT_SECRET=

# Kirish token'i necha daqiqa yashaydi (production tavsiyasi: 15 daqiqa).
ACCESS_TOKEN_MINUTES=15
# Yangilash token'i necha kun (standart: 60).
REFRESH_TOKEN_DAYS=60

# ─────────────────────────────────────────────────────────────────────────────
# SMS
# ─────────────────────────────────────────────────────────────────────────────
# true bo'lsa OTP kodi HTTP javobida qaytadi — SMS provayderisiz butun oqimni
# sinash uchun. Ishlab chiqarishda ALBATTA false: aks holda istalgan odam
# istalgan raqamga kod so'rab, o'sha hisobga kiradi.
OTP_DEBUG=false
OTP_TTL_SECONDS=300

# --- Eskiz (notify.eskiz.uz) -------------------------------------------------
# Bo'sh qoldirilsa SMS ketmaydi — matn faqat logga yoziladi. Ishlab chiqish
# shu holatda ham to'liq yuradi.
#
# Kabinetdagi elektron pochta va parol. Bular hech qayerda chop etilmaydi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Tasdiqlangan jo'natuvchi nomi. "4546" — Eskizning sinov raqami; haqiqiy
# nom shartnoma imzolangach beriladi.
ESKIZ_SENDER=4546

# ⚠️ Eskiz HAR BIR matnni oldindan tasdiqlaydi. Tasdiqlanmagan matn xato
# bermaydi — jimgina yetkazilmaydi. Shuning uchun bu yerdagi matn kabinetda
# tasdiqlangan shakl bilan HARF-BAHARF bir xil bo'lishi kerak.
# `{code}` o'rniga kod qo'yiladi.
ESKIZ_OTP_TEMPLATE=MAB: tasdiqlash kodi {code}. Hech kimga aytmang.

# SMS ketmasa ro'yxatdan o'tish to'xtatilsinmi (503 qaytadi).
# Ishlab chiqarishda true bo'lishi kerak: aks holda odam kod kutadi, kod
# kelmaydi va sabab hech qayerda ko'rinmaydi.
SMS_REQUIRED=false

# ─────────────────────────────────────────────────────────────────────────────
# Suratlar
# ─────────────────────────────────────────────────────────────────────────────
# Yuklangan suratlar saqlanadigan papka. Standart: `api/media`.
# MEDIA_ROOT=/var/lib/barter/media
# MEDIA_URL_PREFIX=/media

# ─────────────────────────────────────────────────────────────────────────────
# Mosliklar
# ─────────────────────────────────────────────────────────────────────────────
# F01: o'zaro moslik (ular ham mening narsamni xohlaydimi) va o'zaro
# mosliklarni birinchi ko'rsatish. false — eski bir tomonlama tartib.
MATCHING_MUTUAL=true

# ─────────────────────────────────────────────────────────────────────────────
# Boshqalar
# ─────────────────────────────────────────────────────────────────────────────
# Bepul e'lonlar kvotasi (biznes hisoblar hozircha ozod).
FREE_LISTING_QUOTA=2

# --- Payme (Merchant API) ---------------------------------------------------
# Bo'sh bo'lsa to'lov o'chiq. Kassa ID'si va kaliti Payme biznes kabinetidan
# (business.paycom.uz → Kassa → Sozlamalar). Sinovda test kaliti va
# test.paycom.uz; jangovar rejimda asosiy kalit va checkout.paycom.uz.
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYME_CHECKOUT_URL=https://test.paycom.uz
# PAYME_RETURN_URL=https://mab.uz/payments/return?order={order_id}

# Vaqtinchalik: Eskiz kelguncha productionni SMS'siz ishga tushirish
# (kodlar faqat server logida). Eskiz ulangach o'chiring.
# SMS_OPTIONAL=true

# Google OAuth client IDs (public identifiers, JSON list). First is the Web client.
# No Google client secret is used by the ID-token verification flow.
GOOGLE_CLIENT_IDS=[]
# SMS_OPTIONAL=true permits startup without Eskiz, but phone auth returns 503.
# No login codes are logged in production.
